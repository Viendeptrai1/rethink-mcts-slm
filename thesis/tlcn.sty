% tlcn.sty: quy cách trình bày tiểu luận chuyên ngành, Khoa CNTT, ĐH Công nghệ Kỹ thuật TP.HCM
% (theo mẫu trình bày KLTN của khoa: mau/Mau-5-TrinhBay-KLTN.docx, mục 3 "Hình thức trình bày"). Biên dịch bằng XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tlcn}[2026/11/14 Quy cach TLCN Khoa CNTT]

% ---------------------------------------------------------------- Khổ giấy, lề, font
% A4 đứng; lề trên 2 cm, dưới 2 cm, trái 3 cm, phải 2 cm.
\RequirePackage[a4paper,top=2cm,bottom=2cm,left=3cm,right=2cm,footskip=1cm]{geometry}
% Font Unicode Times New Roman, cỡ 13 cho nội dung (cỡ đặt ở \documentclass: fontsize=13pt).
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\setmainfont{Times New Roman}
% Công thức toán dùng STIX Two Math (cùng họ thiết kế với Times).
\RequirePackage{unicode-math}
\setmathfont{STIX Two Math}
\RequirePackage[vietnamese]{babel}
% Tiếng Việt là ngôn ngữ đơn âm tiết và TeX Live basic không có mẫu ngắt từ tiếng Việt, nên tắt ngắt từ
% (nếu không, mẫu tiếng Anh sẽ ngắt sai, ví dụ "ngh-iên"); bù lại bằng \emergencystretch khi canh đều.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\setlength{\emergencystretch}{3em}
% Dãn dòng 1.5 lines như Word: dòng đơn của Times New Roman trong Word cao khoảng 1,15 × cỡ chữ,
% nên 1.5 lines ≈ 1,5 × 1,15 × 13 pt ≈ 22,4 pt; baselineskip mặc định của KOMA ở 13 pt là 15,6 pt → hệ số 1,44.
\RequirePackage{setspace}
\setstretch{1.44}
% Nội dung canh đều hai bên (mặc định của LaTeX); thụt đầu dòng 1 cm, kể cả đoạn đầu sau đề mục.
\RequirePackage{indentfirst}
\setlength{\parindent}{1cm}
\setlength{\parskip}{3pt plus 1pt}

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs,longtable,tabularx,multirow,array}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=*,labelindent=\parindent}
% Đầu dòng: cấp 1 dùng gạch ngang, cấp 2 dùng dấu cộng (không dùng chấm tròn).
\setlist[itemize,1]{label=\textendash}
\setlist[itemize,2]{label=+}
\RequirePackage{etoolbox}
\RequirePackage{pdfpages}
\RequirePackage{tikz}

% ---------------------------------------------------------------- Đề mục
% Chương và mục được đánh số Ả-rập; tối đa ba chữ số (2.1.1). Tiểu mục mức 3 không đánh số.
\setcounter{secnumdepth}{\subsectionnumdepth}
\setcounter{tocdepth}{\subsectionnumdepth}
\setkomafont{disposition}{\rmfamily\bfseries}
\setkomafont{descriptionlabel}{\rmfamily\bfseries}
% Tên chương: cỡ 14, in hoa, đậm, canh giữa. Viết tên chương bằng chữ in hoa ngay trong mã nguồn.
\setkomafont{chapter}{\fontsize{14pt}{18pt}\selectfont}
\renewcommand*{\raggedchapter}{\centering}
\renewcommand*{\chapterformat}{\MakeUppercase{\chapapp}~\thechapter:\enskip}
\RedeclareSectionCommand[beforeskip=0pt,afterskip=18pt]{chapter}
% Tiểu mục mức 1 (2.1): cỡ 13, in hoa, đậm, trái. Viết tên mục bằng chữ in hoa trong mã nguồn.
\setkomafont{section}{\normalsize}
\RedeclareSectionCommand[beforeskip=12pt,afterskip=6pt]{section}
% Tiểu mục mức 2 (2.1.1): cỡ 13, chữ thường, đậm, trái.
\setkomafont{subsection}{\normalsize}
\RedeclareSectionCommand[beforeskip=10pt,afterskip=4pt]{subsection}
% Tiểu mục mức 3: cỡ 13, chữ thường, nghiêng, trái.
\setkomafont{subsubsection}{\normalsize\mdseries\itshape}
\RedeclareSectionCommand[beforeskip=8pt,afterskip=4pt]{subsubsection}

% "PHẦN NỘI DUNG": dòng riêng trong mục lục giữa Phần mở đầu và Chương 1.
\newcommand{\phantoc}[1]{\addcontentsline{toc}{part}{#1}}

% ---------------------------------------------------------------- Tên gọi
\renewcaptionname{vietnamese}{\contentsname}{MỤC LỤC}
\renewcaptionname{vietnamese}{\listfigurename}{DANH MỤC HÌNH}
\renewcaptionname{vietnamese}{\listtablename}{DANH MỤC BẢNG}
\renewcaptionname{vietnamese}{\chaptername}{Chương}
\renewcaptionname{vietnamese}{\appendixname}{Phụ lục}
\renewcaptionname{vietnamese}{\figurename}{Hình}
\renewcaptionname{vietnamese}{\tablename}{Bảng}

% ---------------------------------------------------------------- Mục lục
% Dòng chương trong mục lục: "Chương 1: ...", sau \appendix là "Phụ lục A: ...". KOMA đưa số mục kèm \hfil
% vào định dạng số, nên phải \unskip trước dấu hai chấm để dấu này nằm sát số.
\newcommand*{\tocchapprefix}{\chaptername}
\DeclareTOCStyleEntry[numwidth=5.6em,linefill=\TOCLineLeaderFill]{chapter}{chapter}
\DeclareTOCStyleEntry[dynnumwidth]{tocline}{section}
\DeclareTOCStyleEntry[dynnumwidth]{tocline}{subsection}
\DeclareTOCStyleEntry[level=-1,indent=0pt,numwidth=0pt,entryformat=\bfseries,pagenumberformat=\bfseries,
  linefill=\TOCLineLeaderFill,beforeskip=1em plus 1pt]{tocline}{part}
\appto\appendix{\addtocontents{toc}{\protect\renewcommand*{\protect\tocchapprefix}{\protect\appendixname}}}
\DeclareTOCStyleEntry[indent=0pt,numwidth=4.6em]{tocline}{figure}
\DeclareTOCStyleEntry[indent=0pt,numwidth=4.6em]{tocline}{table}
\makeatletter
\renewcommand*{\scr@tso@chapter@numberformat}[1]{\tocchapprefix~#1\unskip:\hfil}
\renewcommand*{\scr@tso@figure@numberformat}[1]{\figurename~#1\unskip:\hfil}
\renewcommand*{\scr@tso@table@numberformat}[1]{\tablename~#1\unskip:\hfil}
\makeatother

% ---------------------------------------------------------------- Hình và bảng
\RequirePackage{caption}
\DeclareCaptionFont{cotenhinh}{\fontsize{11pt}{13pt}\selectfont\bfseries}
\DeclareCaptionFont{cochuthich}{\fontsize{10pt}{12pt}\selectfont\itshape}
% Tên hình: cỡ 11, đậm, giữa, dưới hình. Tên bảng: cỡ 11, đậm, giữa, trên bảng.
\captionsetup{font={cotenhinh,stretch=1},labelsep=colon,justification=centering,singlelinecheck=false}
\captionsetup[figure]{position=below,skip=6pt}
\captionsetup[table]{position=above,skip=6pt}
% Nội dung bảng: cỡ 12, canh giữa, dòng đơn.
\AtBeginEnvironment{table}{\fontsize{12pt}{14pt}\selectfont\setstretch{1}\centering}
\AtBeginEnvironment{longtable}{\fontsize{12pt}{14pt}\selectfont\setstretch{1}}
\AtBeginEnvironment{figure}{\centering}
% Chú thích bảng: cỡ 10, nghiêng, giữa, dưới bảng. Dùng \ghichubang{...} ngay sau tabular.
\newcommand{\ghichubang}[1]{\par\vspace{4pt}{\centering\fontsize{10pt}{12pt}\selectfont\itshape #1\par}}
% Nguồn số liệu KHÔNG in ra trong báo cáo: ghi bằng comment "% Nguồn: ..." ngay trong bảng/hình để truy vết.
% \nguon{...} được giữ lại như một lệnh không in gì, cho các chỗ còn dùng.
\newcommand{\nguon}[1]{}
\graphicspath{{hinh/}{../docs/report/figures/v3/}}

% ---------------------------------------------------------------- Tài liệu tham khảo
% Đánh số theo thứ tự từ điển (tên tác giả); cỡ 11, canh trái. Các thành phần cách nhau bằng dấu phẩy:
% "Tác giả, Tên bài, Tên tạp chí/hội nghị (tập), năm, pp. x–y."
\RequirePackage[backend=biber,style=numeric,sorting=nyt,maxbibnames=99,giveninits=true,
  uniquename=init,language=english,autolang=none,doi=false,isbn=false,url=false,eprint=true]{biblatex}
\DeclareLanguageMapping{vietnamese}{english}
\renewcommand*{\newunitpunct}{\addcomma\space}
\renewbibmacro{in:}{}
\DeclareFieldFormat*{title}{#1}
\DeclareFieldFormat*{journaltitle}{#1}
\DeclareFieldFormat*{booktitle}{#1}
\DeclareFieldFormat{pages}{pp.~#1}
\DeclareNameAlias{sortname}{given-family}
\renewcommand*{\bibfont}{\fontsize{11pt}{13pt}\selectfont\raggedright\setstretch{1.2}}
\defbibheading{tailieu}{\addchap{DANH MỤC TÀI LIỆU THAM KHẢO}}

% ---------------------------------------------------------------- Liên kết
\RequirePackage[hidelinks,unicode,bookmarksnumbered]{hyperref}
% Đường dẫn file trong văn bản: \nolinkurl{...} (được ngắt dòng tại / và _), font cùng cỡ với chữ thường.
\urlstyle{same}
\appto\UrlBreaks{\do\_\do\-}

\endinput
