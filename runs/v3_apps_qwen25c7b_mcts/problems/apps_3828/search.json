      "rev_n_1_55155c_0": {
        "revision_id": "rev_n_1_55155c_0",
        "node_id": "n_1_55155c",
        "thought_text": "Calculate the number of inversions in the array. An inversion is a pair of indices (i, j) such that i < j and p[i] > p[j]. The minimum number of moves required to sort the array is equal to the number of inversions.",
        "parent_revision_path_hash": "root",
        "replaces_revision_id": null,
        "feedback_id": null,
        "created_at": 1794506793.6012924
      },
      "rev_n_2_975c39_0": {
