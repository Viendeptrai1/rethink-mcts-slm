            "source_snippet": "from collections import Counter\n\ndef can_form_lexicographically_smaller(s, t):\n    # Count the frequency of each character in both strings\n    count_s = Counter(s)\n    count_t = Counter(t)\n    \n    # If s has fewer characters than t, we can always make s' < t'\n    if len(s) < len(t):\n        return \"Yes\"\n    \n    # If s has more characters than t, it's impossible to make s' < t'\n    if len(s) > len(t):\n        return \"No\"\n    \n    # If s and t have the same length, we need to check if we can rearrange them\n    # such that s' < t'\n    for char in 'abcdefghijklmnopqrstuvwxyz':\n        if count_s[char] < count_t[char]:\n            return \"Yes\"\n        elif count_s[char] > count_t[char]:\n            return \"No\"\n    \n    # If all characters have the same frequency, s' cannot be < t'\n    return \"No\"\n\n# Read input from stdin\nimport sys\ninput = sys.stdin.read\ndata = input().split()\ns = data[0]\nt = data[1]\n\n# Print the result\nprint(can_form_lexicographically_smaller(s, t))",
