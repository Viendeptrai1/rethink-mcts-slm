            "source_snippet": "def mex(lst):\n    mex_value = 0\n    while mex_value in lst:\n        mex_value += 1\n    return mex_value\n\ndef grundy(n, a):\n    if n == 1:\n        return a[0]\n    \n    grundy_values = [0] * (max(a) + 1)\n    \n    for value in range(1, max(a) + 1):\n        reachable_grundies = set()\n        for i in range(n):\n            if a[i] >= value:\n                reachable_grundies.add(grundy_values[a[i] - value])\n            else:\n                reachable_grundies.add(grundy_values[0])\n        \n        for i in range(n):\n            if a[i] >= value:\n                reachable_grundies.add(grundy_values[a[i] - value] ^ grundy(n - 1, a[:i] + a[i+1:]))\n            else:\n                reachable_grundies.add(grundy_values[0] ^ grundy(n - 1, a[:i] + a[i+1:]))\n        \n        grundy_values[value] = mex(reachable_grundies)\n    \n    return grundy_values[max(a)]\n\ndef determine_winner(n, a):\n    total_grundy = 0\n    for value in a:\n        total_grundy ^= grundy(1, [value])\n    \n    if total_grundy > 0:\n        return \"BitLGM\"\n    else:\n        return \"BitAryo\"\n\nimport sys\ninput = sys.stdin.read\ndata = input().split()\n\nn = int(data[0])\na = list(map(int, data[1:]))\n\nprint(determine_winner(n, a))",
