            "source_snippet": "def main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    pairs = [(int(data[2*i+1]), int(data[2*i+2])) for i in range(n)]\n    \n    def get_divisors(x):\n        divisors = set()\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                divisors.add(i)\n                divisors.add(x // i)\n        return divisors\n    \n    common_divisors = set(range(2, min(a, b) + 1)) & get_divisors(a) & get_divisors(b)\n    \n    for a, b in pairs[1:]:",
