            "source_snippet": "import heapq\nfrom collections import deque\n\ndef sum_of_largest_keys(N, K, keys):\n    MOD = 1000000007\n    \n    # Sort keys in descending order\n    keys.sort(reverse=True)\n    \n    # Use a max-heap to keep track of the smallest of the largest K elements\n    max_heap = []\n    for i in range(K):\n        heapq.heappush(max_heap, keys[i])\n    \n    # Calculate the sum of the largest K elements\n    current_sum = sum(max_heap)\n    \n    # Slide the window of size K over the sorted keys\n    for i in range(K, N):\n        # Remove the smallest element from the current window\n        smallest_in_window = heapq.heappop(max_heap)\n        # Add the new element to the window\n        heapq.heappush(max_heap, keys[i])\n        # Update the current sum\n        current_sum += keys[i] - smallest_in_window\n        # Take modulo 1000000007\n        current_sum %= MOD\n    \n    return current_sum\n\n# Read input\nimport sys\ninput = sys.stdin.read\ndata = input().split()\n\nN = int(data[0])\nK = int(data[1])\nkeys = list(map(int, data[2:]))\n\n# Output the result\nprint(sum_of_largest_keys(N, K, keys))",
