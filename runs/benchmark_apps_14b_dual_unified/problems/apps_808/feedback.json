            "source_snippet": "import sys\n\ndef simple_exponential_notation(x):\n    # Remove leading zeros\n    x = x.lstrip('0')\n    \n    # Check if the number is an integer\n    if '.' not in x:\n        # Convert to integer\n        num = int(x)\n        if num == 0:\n            return \"0\"\n        elif num == 1:\n            return \"1\"\n        else:\n            # Find the highest power of 10 less than or equal to num\n            b = 0\n            while num >= 10:\n                num //= 10\n                b += 1\n            return f\"{num}E{b}\"\n    else:\n        # Split the number into integer and fractional parts\n        integer_part, fractional_part = x.split('.')\n        \n        # Remove trailing zeros from the fractional part\n        fractional_part = fractional_part.rstrip('0')\n        \n        # If the integer part is empty, it means the number is less than 1\n        if not integer_part:\n            # Count the number of leading zeros in the fractional part\n            b = 0\n            while fractional_part[b] == '0':\n                b += 1\n            # Remove the leading zeros\n            fractional_part = fractional_part[b:]\n            # If the fractional part is empty after removing leading zeros, it means the number is 0\n            if not fractional_part:\n                return \"0\"\n            # Construct the result\n            return f\"1.{fractional_part}E-{b}\"\n        else:\n            # If the integer part is not empty, it means the number is greater than or equal to 1\n            # Find the highest power of 10 less than or equal to the integer part\n            b = 0\n            while int(integer_part) >= 10:\n                integer_part = str(int(integer_part) // 10)\n                b += 1\n            # If the fractional part is empty, it means the number is an integer\n            if not fractional_part:\n                return f\"{integer_part}E{b}\"\n            else:\n                # Construct the result\n                return f\"{integer_part}.{fractional_part}E{b}\"\n\n# Read input from stdin\nx = sys.stdin.read().strip()\n\n# Print the result\nprint(simple_exponential_notation(x))",
