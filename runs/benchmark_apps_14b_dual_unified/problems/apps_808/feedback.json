            "source_snippet": "import sys\n\ndef simple_exponential_notation(x):\n    # Remove leading zeros\n    x = x.lstrip('0')\n    \n    # Check if the number is an integer\n    if '.' not in x:\n        x += '.'\n    \n    # Find the position of the decimal point\n    decimal_pos = x.find('.')\n    \n    # Determine the exponent b\n    if decimal_pos == 0:\n        # Number is less than 1\n        b = -1\n        while x[0] == '0':\n            x = x[1:]\n            b -= 1\n        a = x[0]\n        if len(x) > 1:\n            a += x[1:]\n    else:\n        # Number is greater than or equal to 1\n        b = decimal_pos - 1\n        a = x[:decimal_pos]\n        if len(x) > decimal_pos + 1:\n            a += x[decimal_pos+1:]\n    \n    # Remove trailing zeros from a\n    a = a.rstrip('0')\n    \n    # Remove decimal point if it's the last character\n    if a[-1] == '.':\n        a = a[:-1]\n    \n    # Format the result\n    if b == 0:\n        return a\n    else:\n        return f\"{a}E{b}\"\n\n# Read input from stdin\nx = sys.stdin.read().strip()\n\n# Print the result\nprint(simple_exponential_notation(x))",
