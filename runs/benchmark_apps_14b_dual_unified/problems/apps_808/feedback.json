            "source_snippet": "import sys\n\ndef simple_exponential_notation(x):\n    # Remove leading zeros and trailing zeros after decimal point\n    x = x.lstrip('0').rstrip('0').rstrip('.')\n    \n    # Check if the number is already in the range 1 <= a < 10\n    if '.' in x:\n        decimal_point_index = x.index('.')\n        if decimal_point_index == 0:\n            # Case where the number is less than 1\n            a = '1' + x[1:]\n            b = -1 * (len(x) - decimal_point_index - 1)\n        elif decimal_point_index == 1:\n            # Case where the number is already in the range 1 <= a < 10\n            a = x[:decimal_point_index] + x[decimal_point_index+1:]\n            b = 0\n        else:\n            # Case where the number needs to be divided by 10\n            a = x[:decimal_point_index] + '.' + x[decimal_point_index+1:]\n            b = decimal_point_index - 1\n    else:\n        # Case where the number is an integer\n        a = x\n        b = len(x) - 1\n    \n    # Remove trailing zeros after decimal point in a\n    a = a.rstrip('0').rstrip('.')\n    \n    # Format the result\n    if b == 0:\n        return a\n    else:\n        return f\"{a}E{b}\"\n\n# Read input from stdin\nx = sys.stdin.read().strip()\n\n# Print the result\nprint(simple_exponential_notation(x))",
