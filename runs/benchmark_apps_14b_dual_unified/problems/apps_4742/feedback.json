            "source_snippet": "def solve():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    l = int(data[0])\n    melody1 = data[1:1+l]\n    melody2 = data[1+l:]\n    \n    notes = [\"C\", \"C#\", \"D\", \"D#\", \"E\", \"F\", \"F#\", \"G\", \"G#\", \"A\", \"A#\", \"B\"]\n    note_to_index = {note: i for i, note in enumerate(notes)}\n    \n    # Check for Transposition\n    def is_transposition(m1, m2):\n        diff = note_to_index[m2[0]] - note_to_index[m1[0]]\n        for i in range(1, l):\n            if (note_to_index[m2[i]] - note_to_index[m1[i]]) % 12 != diff:\n                return False\n        return True\n    \n    # Check for Retrograde\n    def is_retrograde(m1, m2):\n        return m1 == m2[::-1]\n    \n    # Check for Inversion\n    def is_inversion(m1, m2):\n        if m1[0] != m2[0]:\n            return False\n        for i in range(1, l):\n            interval1 = (note_to_index[m1[i]] - note_to_index[m1[0]]) % 12\n            interval2 = (note_to_index[m2[i]] - note_to_index[m2[0]]) % 12\n            if interval1 + interval2 != 12:\n                return False\n        return True\n    \n    if is_transposition(melody1, melody2):\n        print(\"Transposition\")\n    elif is_retrograde(melody1, melody2):\n        print(\"Retrograde\")\n    elif is_inversion(melody1, melody2):\n        print(\"Inversion\")\n    else:\n        print(\"Nonsense\")\n\nsolve()",
