            "source_snippet": "import sys\n\ndef max_consecutive_erasure(n, a):\n    if n == 1:\n        return 0\n    \n    # Check how many elements can be erased from the start\n    start_erase = 0\n    while start_erase + 1 < n and a[start_erase + 1] - a[start_erase] <= 2:\n        start_erase += 1\n    \n    # Check how many elements can be erased from the end\n    end_erase = 0\n    while end_erase + 1 < n and a[n - 1 - end_erase] - a[n - 2 - end_erase] <= 2:\n        end_erase += 1\n    \n    # Return the maximum of the two possibilities\n    return max(start_erase, end_erase)\n\n# Read input\ninput = sys.stdin.read\ndata = input().split()\nn = int(data[0])\na = list(map(int, data[1:]))\n\n# Output the result\nprint(max_consecutive_erasure(n, a))",
