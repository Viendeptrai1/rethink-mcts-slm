            ],
            "source_snippet": "def min_cost(c1, c2, c3, c4, n, m, a, b):\n    # Calculate the total cost if Vasya buys individual tickets for each ride\n    total_cost = sum(a[i] * c1 for i in range(n)) + sum(b[i] * c1 for i in range(m))\n    \n    # Calculate the cost if Vasya buys unlimited tickets for each bus\n    bus_unlimited_cost = min(sum(a) * c1, c2 * n, c3)\n    \n    # Calculate the cost if Vasya buys unlimited tickets for each trolley\n    trolley_unlimited_cost = min(sum(b) * c1, c2 * m, c3)\n    \n    # Calculate the cost if Vasya buys unlimited tickets for all buses and trolleys\n    all_unlimited_cost = c4\n    \n    # Calculate the minimum cost by considering all possible strategies\n    min_cost = min(total_cost, bus_unlimited_cost + trolley_unlimited_cost, all_unlimited_cost)\n    \n    return min_cost",
