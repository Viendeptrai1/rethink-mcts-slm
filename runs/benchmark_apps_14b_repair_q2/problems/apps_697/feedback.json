            "source_snippet": "MOD = 998244853\n\ndef count_maximal_prefix_sums(n, m):\n    if n == 0:\n        return 0\n    if m == 0:\n        return n * (n + 1) // 2 % MOD\n    \n    total_sum = 0\n    for k in range(n + 1):\n        total_sum += (k + 1) * choose(n, k) * choose(m, n - k)\n        total_sum %= MOD\n    \n    return total_sum\n\ndef choose(n, k):\n    if k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    k = min(k, n - k)\n    c = 1\n    for i in range(k):\n        c = c * (n - i) // (i + 1)\n    return c\n\n# Read input\nimport sys\ninput = sys.stdin.read\ndata = input().split()\nn = int(data[0])\nm = int(data[1])\n\n# Compute and print the result\nresult = count_maximal_prefix_sums(n, m)\nprint(result)",
