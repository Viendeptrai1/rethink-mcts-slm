            "source_snippet": "import sys\nfrom math import gcd\nfrom functools import reduce\n\ndef max_gcd_after_move(N, A):\n    # Calculate the GCD of all numbers\n    current_gcd = reduce(gcd, A)\n    \n    if current_gcd > 1:\n        return current_gcd\n    \n    # If the GCD is 1, we need to find a way to increase it\n    # We can replace any number with a prime factor of another number\n    # Let's find the prime factors of each number\n    def prime_factors(n):\n        i = 2\n        factors = set()\n        while i * i <= n:\n            if n % i:\n                i += 1\n            else:\n                n //= i\n                factors.add(i)\n        if n > 1:\n            factors.add(n)\n        return factors\n    \n    # Collect all unique prime factors\n    all_factors = set()\n    for num in A:\n        all_factors.update(prime_factors(num))\n    \n    # The maximum possible GCD is the largest prime factor found\n    return max(all_factors)\n\n# Read input\ninput = sys.stdin.read\ndata = input().split()\nN = int(data[0])\nA = list(map(int, data[1:]))\n\n# Output the result\nprint(max_gcd_after_move(N, A))",
