            ],
            "source_snippet": "import sys\nimport heapq\n\ndef max_items_without_horn(n, X, prices):\n    # Sort the prices in ascending order\n    prices.sort()\n    \n    # Use a min-heap to keep track of the smallest sums of pairs\n    min_heap = []\n    \n    # Iterate over the sorted prices\n    for price in prices:\n        # If the heap is not empty and the smallest sum is less than or equal to X, pop it\n        if min_heap and min_heap[0] <= X:\n            heapq.heappop(min_heap)\n        \n        # Push the current price into the heap\n        heapq.heappush(min_heap, price * 2)\n    \n    # The size of the heap is the maximum number of items that can be marked\n    return len(min_heap)\n\n# Read input from stdin\ninput = sys.stdin.read\ndata = input().split()\n\nn = int(data[0])\nX = int(data[1])\nprices = list(map(int, data[2:]))\n\n# Print the result\nprint(max_items_without_horn(n, X, prices))",
