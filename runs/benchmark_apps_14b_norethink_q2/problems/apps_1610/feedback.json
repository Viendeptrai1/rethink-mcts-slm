            "source_snippet": "import sys\n\ndef construct_permutation(n, k):\n    # Initialize the permutation array\n    permutation = [0] * n\n    \n    # Fill the first k+1 elements in decreasing order\n    for i in range(k + 1):\n        permutation[i] = n - i\n    \n    # Fill the remaining elements in increasing order\n    for i in range(k + 1, n):\n        permutation[i] = i - k\n    \n    return permutation\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    k = int(data[1])\n    \n    result = construct_permutation(n, k)\n    print(\" \".join(map(str, result)))\n\nif __name__ == \"__main__\":",
